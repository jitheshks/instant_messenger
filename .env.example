# Instant Messenger Environment Configuration
# Copy this file to .env and configure with your project credentials.
#
# Compile-time usage:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Security: .env is gitignored and is NEVER bundled as a Flutter asset.

# Supabase (Primary Backend: Auth, PostgreSQL, Realtime, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# OneSignal (Public Client App ID - REST Master Key is restricted to Server Vault)
ONESIGNAL_APP_ID=70142ddd-32be-40e0-b1ce-97a1b958e3f4

# Legacy Cloudinary (Temporary during migration to Supabase Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset
